{
  "name": "dsh-build-resolver-java",
  "version": "1.0.0",
  "description": "Java/Maven/Gradle build, compilation, and dependency error resolution specialist for DeepSeek Harness (DSH). Minimal surgical fixes, framework-aware, zero refactoring.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "dsh-plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "npm run build && node --test test/parser.test.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "cordis",
    "java",
    "maven",
    "gradle",
    "spring-boot",
    "build-resolver",
    "compiler-fix"
  ],
  "author": "baogandiga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihuajiu/dsh-build-resolver-java.git"
  },
  "bugs": {
    "url": "https://github.com/ihuajiu/dsh-build-resolver-java/issues"
  },
  "homepage": "https://github.com/ihuajiu/dsh-build-resolver-java#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
