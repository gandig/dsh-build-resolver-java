{
  "name": "dsh-build-resolver-java",
  "version": "1.0.0",
  "description": "Surgical resolver for Java, Maven, and Gradle build, compilation, and dependency errors for DeepSeek Harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/parser.test.ts",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "cordis",
    "java",
    "maven",
    "gradle",
    "spring-boot",
    "build-resolver",
    "compiler-fix"
  ],
  "author": "gandig",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gandig/dsh-build-resolver-java.git"
  },
  "bugs": {
    "url": "https://github.com/gandig/dsh-build-resolver-java/issues"
  },
  "homepage": "https://github.com/gandig/dsh-build-resolver-java#readme",
  "engines": {
    "node": ">=20.11.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
